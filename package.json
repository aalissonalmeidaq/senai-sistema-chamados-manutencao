{
  "name": "sistema-chamados-manutencao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
