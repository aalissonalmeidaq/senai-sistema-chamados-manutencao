# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NUNCA versionar .env.local ou chaves. Só o modelo .env.example.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase (arquivos locais da CLI)
supabase/.branches
supabase/.temp
supabase/snippets
supabase/signing_keys.json

# testes E2E (Playwright)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# pacote exportado para estudantes
/dist-aluno/

# banco de dados local / dumps e backups (podem conter dados de usuários)
/backups/
*.db
*.sqlite
*.dump
*.backup
