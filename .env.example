# Modelo de variáveis de ambiente. NÃO coloque valores reais neste arquivo.
#
# Ambiente LOCAL: rode `npm run setup:local` — ele cria o .env.local
# automaticamente com os valores mostrados por `npx supabase status`.
# Para fazer manualmente: copie este arquivo para .env.local e substitua:
#   NEXT_PUBLIC_SUPABASE_URL             -> valor "API_URL" (ex.: http://127.0.0.1:55321)
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY -> valor "PUBLISHABLE_KEY" (começa com sb_publishable_)
#
# NUNCA use aqui a chave secreta (SECRET_KEY / service_role). Variáveis
# NEXT_PUBLIC_* ficam visíveis no navegador.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=coloque-aqui-a-chave-publicavel
